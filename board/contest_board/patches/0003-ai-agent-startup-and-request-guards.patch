+#if AGENT_LOOP_BISECT_A2E
+static pthread_mutex_t s_agent_bisect_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t s_agent_bisect_cond = PTHREAD_COND_INITIALIZER;
+
+#define AGENT_LOOP_DUMMY_REDZONE_BYTES 32
+
+static char* s_dummy_tools_raw;
+static char* s_dummy_tools;
+static size_t s_dummy_tools_size;
+static bool s_dummy_tools_held;
+
+static void agent_loop_bisect_fill_canary(char* ptr)
+{
+    memset(ptr, 0xd3, AGENT_LOOP_DUMMY_REDZONE_BYTES);
+}
+
+static bool agent_loop_bisect_canary_ok(const char* ptr)
+{
+    for (size_t i = 0; i < AGENT_LOOP_DUMMY_REDZONE_BYTES; i++) {
+        if ((unsigned char)ptr[i] != 0xd3) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void agent_loop_bisect_http_canary_check(const char* phase)
+{
+    bool ok = s_dummy_tools_size == 0 ||
+        (s_dummy_tools_raw != NULL && s_dummy_tools != NULL &&
+            agent_loop_bisect_canary_ok(s_dummy_tools_raw) &&
+            agent_loop_bisect_canary_ok(s_dummy_tools + s_dummy_tools_size));
+
+    syslog(LOG_INFO, "[HEAP-DIAG] canary dummy %s ok=%d\n", phase,
+        ok ? 1 : 0);
+}
+
+int agent_loop_bisect_heap_hold(size_t size)
+{
+    agent_mem_status_t before;
+    agent_mem_status_t after;
+
+    if (s_dummy_tools_held) {
+        syslog(LOG_WARNING, "[HEAP-DIAG] dummy already held\n");
+        return ERROR;
+    }
+
+    agent_mem_get_status(&before);
+    syslog(LOG_INFO, "[HEAP-DIAG] heap before=%zu\n", before.free_heap);
+
+    if (size > 0) {
+        s_dummy_tools_raw = malloc(size + 2 * AGENT_LOOP_DUMMY_REDZONE_BYTES);
+        if (!s_dummy_tools_raw) {
+            syslog(LOG_ERR, "[HEAP-DIAG] dummy allocation failed size=%zu\n", size);
+            return ERROR;
+        }
+
+        s_dummy_tools = s_dummy_tools_raw + AGENT_LOOP_DUMMY_REDZONE_BYTES;
+        agent_loop_bisect_fill_canary(s_dummy_tools_raw);
+        memset(s_dummy_tools, 0xa5, size);
+        agent_loop_bisect_fill_canary(s_dummy_tools + size);
+    }
+
+    s_dummy_tools_size = size;
+    s_dummy_tools_held = true;
+    agent_mem_get_status(&after);
+    syslog(LOG_INFO, "[HEAP-DIAG] dummy size=%zu ptr=%p\n", size,
+        (void*)s_dummy_tools);
+    syslog(LOG_INFO, "[HEAP-DIAG] heap after=%zu\n", after.free_heap);
+    return OK;
+}
